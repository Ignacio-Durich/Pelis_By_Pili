# Copiar a .env.local (ignorado por git) y completar. Nunca versionar claves.

# Supabase → Project Settings → Data API: "Project URL".
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys: la clave pública ("publishable" o "anon"). Es la única clave que llega al navegador.
VITE_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API Keys: la clave secreta ("secret" o "service_role"). Solo para scripts y tests locales.
SUPABASE_SERVICE_ROLE_KEY=
# TMDB → Settings → API (themoviedb.org/settings/api): "API Key" (v3). Solo scripts locales en estas etapas.
TMDB_API_KEY=
# OMDb → omdbapi.com/apikey.aspx (plan FREE, llega por email; 1.000 consultas por día). Solo scripts locales.
OMDB_API_KEY=
