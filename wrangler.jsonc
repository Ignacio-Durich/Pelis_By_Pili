// Hosting en Cloudflare (Workers con archivos estáticos): sirve dist/ sin código propio.
// Las rutas desconocidas devuelven index.html (app de una sola página).
{
  "name": "pelis-by-pili",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
